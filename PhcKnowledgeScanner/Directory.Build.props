<Project>
  <PropertyGroup>
    <!-- Default TFM; WPF Desktop overrides with net10.0-windows -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SqlClient audit advisories: pin mitigated where possible; do not fail build on NU19xx -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903</WarningsNotAsErrors>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
    <Deterministic>true</Deterministic>
    <Company>PhcKnowledgeScanner</Company>
    <Product>PhcKnowledgeScanner</Product>
  </PropertyGroup>
</Project>
