<Window x:Class="PhcKnowledgeScanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="PHC Knowledge Scanner"
        Height="860" Width="1360"
        MinHeight="680" MinWidth="1080"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Nav -->
    <Border Grid.Column="0" Background="#0F1218" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0" Padding="18,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="PHC" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"/>
          <TextBlock Text="Knowledge Scanner" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>
          <Button x:Name="NavConnection" Content="Ligação" Style="{StaticResource NavButtonSelected}" Click="Nav_Click" Tag="connection"/>
          <Button x:Name="NavProgress" Content="Recolha" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="progress"/>
          <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="dashboard"/>
          <Button x:Name="NavInventory" Content="Inventário" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="inventory"/>
          <Button x:Name="NavExplorer" Content="Explorador" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="explorer"/>
          <Button x:Name="NavAnalysis" Content="Análise" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="analysis"/>
          <Button x:Name="NavExport" Content="Exportação" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="export"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#14181F" CornerRadius="12" Padding="12" Margin="0,16,0,0"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="16"
                     Text="SQL em leitura. Factos ≠ inferências."/>
        </Border>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="28,24,28,24">
      <!-- Connection -->
      <Grid x:Name="PageConnection" Visibility="Visible">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Style="{StaticResource PageTitle}" Text="Ligação SQL Server"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Ligue à base PHC e inicie a recolha técnica."/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Servidor"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServer" Text="localhost"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Base de dados"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDatabase"/>

            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Autenticação"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbAuth" SelectionChanged="CmbAuth_OnSelectionChanged">
              <ComboBoxItem Content="Windows" IsSelected="True" Tag="Windows"/>
              <ComboBoxItem Content="SQL Server" Tag="SqlPassword"/>
            </ComboBox>

            <TextBlock Grid.Row="3" x:Name="LblUser" Style="{StaticResource FieldLabel}" Text="Utilizador" Visibility="Collapsed"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtUser" Visibility="Collapsed"/>

            <TextBlock Grid.Row="4" x:Name="LblPassword" Style="{StaticResource FieldLabel}" Text="Palavra-passe" Visibility="Collapsed"/>
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="TxtPassword" Visibility="Collapsed"/>

            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Testar ligação" Click="BtnTestConnection_Click"/>
              <Button Content="Iniciar recolha" Style="{StaticResource PrimaryButton}" Click="BtnStartScan_Click"/>
              <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtConnectionStatus" TextWrapping="Wrap" Margin="0,14,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="A palavra-passe nunca é guardada em disco nem em logs."/>
          </Grid>
        </Border>
      </Grid>

      <!-- Progress -->
      <Grid x:Name="PageProgress" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Progresso da recolha"/>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="TxtProgressStage" Text="Aguardando..." FontSize="16"/>
            <TextBlock x:Name="TxtProgressDetail" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <ProgressBar x:Name="ProgressBarScan" Height="16" Minimum="0" Maximum="100" Value="0"/>
            <UniformGrid Columns="4" Margin="0,16,0,0">
              <TextBlock x:Name="TxtStatProcessed" Text="Processados: 0"/>
              <TextBlock x:Name="TxtStatSuccess" Text="Sucessos: 0"/>
              <TextBlock x:Name="TxtStatWarnings" Text="Avisos: 0"/>
              <TextBlock x:Name="TxtStatErrors" Text="Falhas: 0"/>
            </UniformGrid>
            <TextBlock x:Name="TxtProgressElapsed" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
        <ListBox Grid.Row="2" x:Name="LstProgressLog" Margin="0,16,0,0"/>
      </Grid>

      <!-- Dashboard -->
      <ScrollViewer x:Name="PageDashboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
          <DockPanel Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" Margin="0"/>
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                         Text="Resumo da última recolha — personalizações e estrutura custom."/>
            </StackPanel>
            <Border DockPanel.Dock="Right" x:Name="BadgeDashStatus" CornerRadius="999" Padding="14,7"
                    Background="#1A2A20" BorderBrush="#2F5A40" BorderThickness="1"
                    VerticalAlignment="Top" Margin="12,0,0,0">
              <TextBlock x:Name="TxtDashBadge" Text="—" Foreground="#5ECF8E" FontWeight="SemiBold" FontSize="12"/>
            </Border>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
            <StackPanel>
              <TextBlock x:Name="TxtDashInstallation" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtDashStatus" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <UniformGrid x:Name="PanelKpiCards" Columns="3" Margin="0,0,0,14"/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18" MinHeight="200">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Activo vs Inactivo" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Personalizações com estado (inactivo/inativo) — por tipo"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel x:Name="PanelChartActivity"/>
            </DockPanel>
          </Border>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" MinHeight="280">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <TextBlock Text="Personalizações PHC" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Eventos, regras, ecrãs, T-SQL, teclas e campos u_*"
                             Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="PanelChartPersonalizations"/>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" MinHeight="280">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <TextBlock Text="Estrutura custom (u_*)" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Tabelas de utilizador e metadados associados"
                             Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="PanelChartStructure"/>
              </DockPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource Card}" Padding="18">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Avisos e falhas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtIssuesSummary" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="LstIssues" MaxHeight="220"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Inventário: workspace SQLite existente (ScanKnowledgeSession) -->
      <Grid x:Name="PageInventory" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource PageTitle}" Text="Inventário de tabelas"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Abra um workspace SQLite existente (read-only). Pesquisa em memória — sem nova recolha."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Abrir workspace…" Style="{StaticResource PrimaryButton}"
                      Click="BtnOpenWorkspace_Click" Margin="0,0,8,0" MinWidth="140"/>
              <Button Content="Fechar sessão" Style="{StaticResource GhostButton}"
                      Click="BtnCloseWorkspaceSession_Click" MinWidth="110"/>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="TxtInventorySessionTitle" FontSize="15" FontWeight="SemiBold"
                         Text="Nenhum workspace aberto"/>
              <TextBlock x:Name="TxtInventorySessionMeta" Foreground="{StaticResource MutedBrush}"
                         FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Seleccione a pasta do scan ou o ficheiro workspace.db."/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="TxtInventorySearch"
                       VerticalContentAlignment="Center"
                       IsEnabled="False"
                       TextChanged="TxtInventorySearch_OnTextChanged"
                       KeyDown="TxtInventorySearch_OnKeyDown"/>
              <TextBlock x:Name="TxtInventorySearchWatermark"
                         Text="Pesquisar tabela (ex.: bo, cl, u_…)"
                         Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Foreground="{StaticResource MutedBrush}"
                         Opacity="0.7"/>
            </Grid>
            <TextBlock Grid.Column="1" x:Name="TxtInventoryResultCount"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </Grid>
        </Border>

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Tabelas" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource MutedBrush}" Margin="4,2,4,8"/>
              <ListBox x:Name="LstInventoryTables"
                       DisplayMemberPath="Display"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionChanged="InventoryTable_OnSelectionChanged"/>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="160"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="1.2*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="TxtInventoryDetailTitle" FontSize="18" FontWeight="SemiBold"
                           Text="Seleccione uma tabela"/>
                <TextBlock x:Name="TxtInventoryDetailBody" Margin="0,6,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="TxtInventoryRelationSummary" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
              <TabControl x:Name="TabInventoryRelations" Background="Transparent" BorderThickness="0">
                <TabItem Header="Relações de saída">
                  <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="TxtOutgoingCount" DockPanel.Dock="Top"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,6"/>
                    <ListBox x:Name="LstOutgoingRelations"
                             DisplayMemberPath="CompactDisplay"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="InventoryRelation_OnSelectionChanged"/>
                  </DockPanel>
                </TabItem>
                <TabItem Header="Relações de entrada">
                  <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="TxtIncomingCount" DockPanel.Dock="Top"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,6"/>
                    <ListBox x:Name="LstIncomingRelations"
                             DisplayMemberPath="CompactDisplay"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="InventoryRelation_OnSelectionChanged"/>
                  </DockPanel>
                </TabItem>
              </TabControl>
            </Border>

            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="0.9*" MinHeight="70"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="0.85*" MinHeight="60"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnNavigateRelatedFrom" Content="Ir para origem"
                            Style="{StaticResource GhostButton}" IsEnabled="False"
                            Click="BtnNavigateRelatedFrom_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNavigateRelatedTo" Content="Ir para destino"
                            Style="{StaticResource GhostButton}" IsEnabled="False"
                            Click="BtnNavigateRelatedTo_Click"/>
                  </StackPanel>
                  <TextBlock Text="Detalhe da relação" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="TxtRelationDetailBody"
                             Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11"
                             Text="Seleccione uma relação de saída ou de entrada."/>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,10,0,6">
                  <TextBlock x:Name="TxtFieldMappingCount" DockPanel.Dock="Right"
                             Foreground="{StaticResource MutedBrush}" FontSize="11"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="Mapeamentos de campos" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox Grid.Row="3" x:Name="LstFieldMappings"
                         DisplayMemberPath="CompactDisplay"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="FieldMapping_OnSelectionChanged"/>

                <TextBlock Grid.Row="4" Text="Detalhe do mapeamento" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>

                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="TxtFieldMappingDetailBody"
                             Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11"
                             Text="Seleccione um mapeamento."/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Explorer: filtros no topo · lista + código -->
      <Grid x:Name="PageExplorer" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
          <TextBlock Style="{StaticResource PageTitle}" Text="Explorador" Margin="0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtResultCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.2*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="0.9*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="Pesquisar" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <TextBlock Grid.Column="2" Text="Tipo" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <TextBlock Grid.Column="6" Text="Ordenar" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>

            <Grid Grid.Row="1" Grid.Column="0">
              <TextBox x:Name="TxtSearch"
                       Margin="0"
                       VerticalContentAlignment="Center"
                       TextChanged="TxtSearch_OnTextChanged"
                       KeyDown="TxtSearch_OnKeyDown"/>
              <TextBlock x:Name="TxtSearchWatermark"
                         Text="FT, BO, SFT, HCA_Cria…"
                         Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Foreground="{StaticResource MutedBrush}"
                         Opacity="0.7"/>
            </Grid>

            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CmbObjectKind" SelectionChanged="ExplorerFilter_Changed">
              <ComboBoxItem Content="(todos os tipos)" Tag="" IsSelected="True"/>
              <ComboBoxItem Content="Eventos (Desktop)" Tag="phc.event"/>
              <ComboBoxItem Content="Eventos (Web)" Tag="phc.web_event"/>
              <ComboBoxItem Content="Regras (brule)" Tag="phc.user_rule"/>
              <ComboBoxItem Content="Regras Web (ebrule)" Tag="phc.web_user_rule"/>
              <ComboBoxItem Content="Valores por defeito" Tag="phc.default_value"/>
              <ComboBoxItem Content="Valores por defeito Web" Tag="phc.web_default_value"/>
              <ComboBoxItem Content="Campos utilizador (u_*)" Tag="phc.user_field"/>
              <ComboBoxItem Content="Teclas" Tag="phc.hotkey"/>
              <ComboBoxItem Content="Scripts Web (escr)" Tag="phc.web_script"/>
              <ComboBoxItem Content="JavaScript utilizador (jsu)" Tag="phc.user_javascript"/>
              <ComboBoxItem Content="CSS/JS Web (cssjs)" Tag="phc.web_cssjs"/>
              <ComboBoxItem Content="Grelhas ocultas (formc)" Tag="phc.hidden_grid"/>
              <ComboBoxItem Content="Ecrãs personalizados (formb)" Tag="phc.custom_screen"/>
              <ComboBoxItem Content="Funções T-SQL (ftu)" Tag="phc.user_tsql_function"/>
              <ComboBoxItem Content="Tabelas custom (u_*)" Tag="table"/>
              <ComboBoxItem Content="Views" Tag="view"/>
              <ComboBoxItem Content="Procedures" Tag="stored_procedure"/>
              <ComboBoxItem Content="Triggers (tabelas u_*)" Tag="trigger"/>
              <ComboBoxItem Content="Foreign keys (tabelas u_*)" Tag="foreign_key"/>
              <ComboBoxItem Content="Primary keys (tabelas u_*)" Tag="primary_key"/>
            </ComboBox>

            <ComboBox Grid.Row="1" Grid.Column="4" x:Name="CmbEstado" SelectionChanged="ExplorerFilter_Changed">
              <ComboBoxItem Content="Todos" Tag="" IsSelected="True"/>
              <ComboBoxItem Content="Activo" Tag="Activo"/>
              <ComboBoxItem Content="Inactivo" Tag="Inactivo"/>
            </ComboBox>

            <ComboBox Grid.Row="1" Grid.Column="6" x:Name="CmbSort" SelectionChanged="ExplorerFilter_Changed">
              <ComboBoxItem Content="Tipo · nome" Tag="kind" IsSelected="True"/>
              <ComboBoxItem Content="Nome" Tag="name"/>
              <ComboBoxItem Content="Inactivos primeiro" Tag="inactive"/>
            </ComboBox>

            <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Ir" Width="52" Click="BtnSearch_Click" Margin="0,0,6,0"/>
              <Button Content="Limpar" Style="{StaticResource GhostButton}" Width="64" Click="BtnClearSearch_Click" Margin="0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Categorias" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource MutedBrush}" Margin="4,2,4,8"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LstObjectGroups">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Expander Style="{StaticResource ExplorerAccordion}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                          <DockPanel>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"/>
                            <Border DockPanel.Dock="Right" Background="#1F2630" CornerRadius="8" Padding="8,2" Margin="8,0,4,0">
                              <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                          </DockPanel>
                        </Expander.Header>
                        <ListBox ItemsSource="{Binding Items}"
                                 DisplayMemberPath="Display"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="320"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="GroupedObject_OnSelectionChanged"/>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="TxtObjectTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                             Text="Seleccione uma categoria e depois um objecto"/>
                  <TextBlock x:Name="TxtObjectMeta" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                             FontSize="12" Margin="0,4,0,0"/>
                  <TextBlock x:Name="TxtFindStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                  <Button Content="Copiar" Click="BtnCopyAll_Click" Margin="0,0,6,0"/>
                  <Button Content="Selecção" Click="BtnCopySelection_Click" Margin="0,0,6,0"/>
                  <Button Content="Localizar" Style="{StaticResource GhostButton}" Click="BtnFindInCode_Click"
                          ToolTip="Ctrl+F" Margin="0"/>
                </StackPanel>
              </DockPanel>
              <Border Background="#0F1218" CornerRadius="10" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      ClipToBounds="True">
                <avalonEdit:TextEditor x:Name="CodeEditor"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="13"
                                       ShowLineNumbers="True"
                                       IsReadOnly="True"
                                       WordWrap="False"
                                       Background="#0F1218"
                                       Foreground="#E8E6E1"
                                       Padding="4"/>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Analysis -->
      <Grid x:Name="PageAnalysis" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="Análise técnica"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Relações derivadas a partir dos factos (ex.: FK entre tabelas custom u_*). O inventário de código está no Explorador."/>
          <TextBlock x:Name="TxtAnalysisEmpty" Visibility="Collapsed" Margin="0,0,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     Text="Sem relações para mostrar. Após a recolha, aparecem aqui as FK das tabelas custom (u_*)."/>
        </StackPanel>
        <DataGrid x:Name="GridRelations" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Camada" Binding="{Binding Layer}" Width="100"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="Tipo" Binding="{Binding RelationType}" Width="160"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="De" Binding="{Binding FromObjectId}" Width="*"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="Para" Binding="{Binding ToObjectId}" Width="*"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="Confiança" Binding="{Binding Confidence}" Width="90"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="Validação" Binding="{Binding ValidationState}" Width="110"
                                ElementStyle="{StaticResource DataGridCellText}"/>
            <DataGridTextColumn Header="Explicação" Binding="{Binding Explanation}" Width="2*"
                                ElementStyle="{StaticResource DataGridCellText}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Export -->
      <Grid x:Name="PageExport" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Exportação"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="ZIP de personalizações PHC: brule, ebrule, udefs, eudefs, eventos, eeventos, teclas, campos, formc, formb, ftu."
                         TextWrapping="Wrap" Margin="0,0,0,12"/>
              <Button Content="Exportar ZIP de personalizações…" Style="{StaticResource PrimaryButton}" Click="BtnExport_Click" HorizontalAlignment="Left"/>
              <TextBlock x:Name="TxtExportStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Database Schema Snapshot — metadados estruturais (tabelas, campos, PK/FK, índices, views, triggers, procedures, funções). Sem registos nem código SQL completo."
                         TextWrapping="Wrap" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Gerar schema snapshot…" Style="{StaticResource PrimaryButton}" Click="BtnSchemaSnapshot_Click" HorizontalAlignment="Left"/>
                <CheckBox x:Name="ChkSchemaIncludeSql" Content="Incluir definições SQL (não partilhável)" Margin="16,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="TxtSchemaSnapshotStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
