{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phcknowledge.local/schemas/ikp-0.1/capabilities.schema.json",
  "title": "IKP 0.1 capabilities",
  "type": "object",
  "required": [
    "schemaVersion",
    "scannerVersion",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "scannerVersion": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "categoryId",
          "operationId",
          "capabilityVersion",
          "collectorId",
          "supported"
        ],
        "properties": {
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "capabilityVersion": {
            "type": "string",
            "minLength": 1
          },
          "collectorId": {
            "type": "string",
            "minLength": 1
          },
          "supported": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
