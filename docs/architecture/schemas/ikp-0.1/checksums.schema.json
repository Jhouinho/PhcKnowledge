{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phcknowledge.local/schemas/ikp-0.1/checksums.schema.json",
  "title": "IKP 0.1 checksums",
  "type": "object",
  "required": [
    "schemaVersion",
    "algorithm",
    "files",
    "logicalContentDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "algorithm": {
      "const": "SHA-256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "byteLength",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "logicalContentDigest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
