{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phcknowledge.local/schemas/ikp-0.1/object-index.schema.json",
  "title": "IKP 0.1 object index (schemaVersion 2)",
  "type": "object",
  "required": [
    "schemaVersion",
    "captureId",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "captureId": {
      "type": "string",
      "format": "uuid"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceObjectId",
          "objectKind",
          "metadata",
          "definition",
          "operationId"
        ],
        "properties": {
          "sourceObjectId": {
            "type": "string",
            "minLength": 1
          },
          "objectKind": {
            "type": "string",
            "minLength": 1
          },
          "sourceIdentity": {
            "type": "object",
            "required": [
              "scheme",
              "value",
              "scope"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "name": {
            "type": "string"
          },
          "schemaName": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "metadataFingerprint": {
            "$ref": "#/$defs/fingerprint"
          },
          "definition": {
            "type": "object",
            "required": [
              "status",
              "artifactIds"
            ],
            "properties": {
              "status": {
                "enum": [
                  "Available",
                  "Empty",
                  "Unavailable",
                  "NotCollected"
                ]
              },
              "artifactIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "definitionFingerprint": {
                "$ref": "#/$defs/definitionFingerprint"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "Available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "artifactIds": {
                      "minItems": 1
                    },
                    "definitionFingerprint": {
                      "$ref": "#/$defs/definitionFingerprint"
                    }
                  },
                  "required": [
                    "definitionFingerprint"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "Empty",
                        "Unavailable",
                        "NotCollected"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "definitionFingerprint"
                    ]
                  }
                }
              }
            ],
            "additionalProperties": true
          },
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "parentSourceObjectId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "definitionFingerprint": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "algorithm",
            "value",
            "policy"
          ],
          "properties": {
            "status": {
              "const": "Available"
            },
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "policy": {
              "type": "object",
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "reasonCode"
          ],
          "properties": {
            "status": {
              "const": "Unavailable"
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
