{
  "ConnectionStrings": {
    "Knowledge": "Server=YOUR_SQL_SERVER;Database=PhcKnowledge;Integrated Security=True;Encrypt=True;TrustServerCertificate=False"
  },
  "Storage": {
    "ArchiveDirectory": "D:\\PhcKnowledge\\archive",
    "StagingDirectory": "D:\\PhcKnowledge\\staging"
  },
  "Authentication": {
    "Jwt": {
      "Enabled": false
    },
    "Authority": "https://login.example.com/tenant-or-realm",
    "Issuer": "https://login.example.com/tenant-or-realm",
    "Audience": "phcknowledge-ikp-api",
    "OrganizationClaimType": "organization_id",
    "RequireHttpsMetadata": true
  },
  "Upload": {
    "MaxUploadBytes": 262144000,
    "MaxConcurrentUploads": 1
  },
  "Recovery": {
    "BatchSize": 20,
    "IntervalSeconds": 60,
    "LeaseSeconds": 300
  },
  "Staging": {
    "CleanupIntervalMinutes": 15,
    "RetentionHours": 24
  },
  "Operations": {
    "MonitorIntervalMinutes": 5,
    "PendingAlertAfterMinutes": 60,
    "AlertRepeatIntervalMinutes": 60
  }
}
